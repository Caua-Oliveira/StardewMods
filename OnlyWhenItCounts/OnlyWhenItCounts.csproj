<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GamePath>C:\Games\Stardew Valley</GamePath>
		<AssemblyName>OnlyWhenItCounts</AssemblyName>
		<OutputType>Library</OutputType>
		<EnableHarmony>true</EnableHarmony>
		<DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
	</PropertyGroup>
	<Target Name="LaunchGameAfterBuild" AfterTargets="Build" Condition="'$(RunGameAfterBuild)' == 'true'">
		<Exec Command="&quot;$(GamePath)\StardewModdingAPI.exe&quot;" />
	</Target>
	<ItemGroup>
		<PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
	</ItemGroup>

</Project>
