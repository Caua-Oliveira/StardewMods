<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GamePath>C:\Games\Stardew Valley</GamePath>
		<AssemblyName>AutomateToolSwap</AssemblyName>
		<Version>1.6.3</Version>
		<OutputType>Library</OutputType>
	</PropertyGroup>
	<Target Name="LaunchGame" AfterTargets="Build" Condition="'$(LaunchGameAfterBuild)' == 'true'">
		<Exec Command="&quot;$(GamePath)\StardewModdingAPI.exe&quot;" />
	</Target>
	<ItemGroup>
		<Compile Remove="tests/**/*.cs" />
		<None Remove="tests/bin/**;tests/obj/**;releases/**" />
		<PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
	</ItemGroup>

</Project>
