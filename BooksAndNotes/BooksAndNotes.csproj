<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyName>BooksAndNotes</AssemblyName>
    <Authors>Trapyy</Authors>
    <Company>Trapyy</Company>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Reference Include="Stardew Valley" HintPath="$(GamePath)\Stardew Valley.dll" Private="false" />
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)\MonoGame.Framework.dll" Private="false" />
    <Reference Include="xTile" HintPath="$(GamePath)\xTile.dll" Private="false" />
    <Reference Include="StardewModdingAPI" HintPath="$(SmapiPath)\StardewModdingAPI.dll" Private="false" />
    <Reference Include="SMAPI.Toolkit.CoreInterfaces" HintPath="$(SmapiPath)\smapi-internal\SMAPI.Toolkit.CoreInterfaces.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SmapiPath)\smapi-internal\0Harmony.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGamePath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GamePath)\Stardew Valley.dll')" Text="Set GamePath to your Stardew Valley game folder. See README.md." />
    <Error Condition="!Exists('$(SmapiPath)\StardewModdingAPI.dll')" Text="Set SmapiPath to a folder containing SMAPI (normally the game folder). See README.md." />
  </Target>
</Project>
