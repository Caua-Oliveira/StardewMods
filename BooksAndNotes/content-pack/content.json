{
  "Format": "2.7.0",
  "ConfigSchema": {
    "HideUnusedFrameworkItems": {
      "AllowValues": "true, false",
      "Default": "true",
      "Description": "Hides framework items not used by Books and Notes. Set to false if you install another mod that uses Si's Extra Crafting Materials."
    }
